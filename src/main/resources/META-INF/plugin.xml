<idea-plugin>
    <id>io.github.tjdgus903.springconfigguard</id>
    <name>Spring Config Guard</name>
    <vendor>tjdgus903</vendor>
    <description><![CDATA[
        Detect risky Spring Boot production configuration before deployment.
    ]]></description>
    <idea-version since-build="261"/>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <localInspection
                shortName="SpringConfigGuardProductionConfig"
                displayName="Risky Spring Boot production configuration"
                groupName="Spring Config Guard"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="io.github.tjdgus903.springconfigguard.inspection.SpringConfigGuardInspection"/>
    </extensions>

    <actions>
        <action
                id="SpringConfigGuard.AnalyzeConfigKeyMappings"
                class="io.github.tjdgus903.springconfigguard.action.AnalyzeConfigKeyMappingsAction"
                text="Spring Config Guard: Analyze Config Key Mappings"
                description="Connect local Spring Boot configuration keys to Java references">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action
                id="SpringConfigGuard.AnalyzeProfileDrift"
                class="io.github.tjdgus903.springconfigguard.action.AnalyzeProfileDriftAction"
                text="Spring Config Guard: Analyze Profile Drift"
                description="Analyze Spring Boot profile drift using local deterministic rules">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
